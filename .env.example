# Leave URL and model blank to keep default Ollama generation disabled.
INFERENCE_PROVIDER=ollama
INFERENCE_ALLOW_EXTERNAL=false
INFERENCE_API_KEY=
INFERENCE_BASE_URL=
INFERENCE_MODEL=
INFERENCE_TIMEOUT_MS=30000
INFERENCE_CONTEXT_TOKENS=2048
INFERENCE_MAX_OUTPUT_TOKENS=512

# Optional read-only Notion connection for Sync.
NOTION_TOKEN=
